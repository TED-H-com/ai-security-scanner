+const MAX_SUBMATCHES: usize = 16;
+
+fn capture_values(
+    captures: regex::Captures<'_>,
+    stop_at_first_unmatched: bool,
+) -> Vec<NaslValue> {
+    let mut values = Vec::with_capacity(captures.len().min(MAX_SUBMATCHES));
+    for capture in captures.iter().take(MAX_SUBMATCHES) {
+        match capture {
+            Some(value) => values.push(NaslValue::String(value.as_str().to_string())),
+            None if stop_at_first_unmatched => break,
+            None => values.push(NaslValue::Null),
+        }
+    }
+    if !stop_at_first_unmatched {
+        while values.last() == Some(&NaslValue::Null) {
+            values.pop();
+        }
+    }
+    values
 }
 
