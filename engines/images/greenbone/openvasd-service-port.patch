+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::storage::{Dispatcher, inmemory::InMemoryStorage};
+
+    #[test]
+    fn symbolic_service_required_ports_use_the_exact_kb_key() {
+        assert_eq!(
+            required_port_key(Protocol::TCP, "Services/www").to_string(),
+            "Services/www"
+        );
+        assert_eq!(
+            required_port_key(Protocol::UDP, "Services/udp/unknown").to_string(),
+            "Services/udp/unknown"
+        );
+        assert_eq!(
+            required_port_key(Protocol::TCP, "8080").to_string(),
+            "Ports/tcp/8080"
+        );
+    }
+
+    #[tokio::test]
+    async fn required_ports_are_alternatives() {
+        let storage = InMemoryStorage::new();
+        let context = KbContext::default();
+        storage
+            .dispatch(
+                KbContextKey(
+                    context.clone(),
+                    required_port_key(Protocol::TCP, "Services/www"),
+                ),
+                KbItem::Number(8080),
+            )
+            .await
+            .unwrap();
+
+        let ports = vec!["Services/www".to_string(), "80".to_string()];
+        assert!(any_required_port_available(&storage, &context, Protocol::TCP, &ports).await);
+    }
