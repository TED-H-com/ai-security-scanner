+/// A receive timeout surfaces as `WouldBlock` on Unix and as `TimedOut` on Windows.
+fn is_read_timeout(e: &io::Error) -> bool {
+    matches!(
+        e.kind(),
+        io::ErrorKind::WouldBlock | io::ErrorKind::TimedOut
+    )
+}
