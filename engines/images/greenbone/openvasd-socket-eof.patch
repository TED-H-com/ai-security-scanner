+#[cfg(test)]
+mod tests {
+    use std::{io::Cursor, net::TcpListener, sync::mpsc, thread};
+
+    use super::*;
+
+    fn connected_socket(listener: &TcpListener) -> (NaslSockets, usize) {
+        let port = listener.local_addr().unwrap().port();
+        let conn = TcpConnection::connect(
+            IpAddr::V4(Ipv4Addr::LOCALHOST),
+            port,
+            None,
+            Duration::from_secs(5),
+            None,
+            1,
+        )
+        .unwrap();
+        let mut sockets = NaslSockets::default();
+        let fd = sockets.add(NaslSocket::Tcp(Box::new(conn)));
+        (sockets, fd)
+    }
+
+    /// Bounds `recv` so a regression fails the test instead of hanging the suite.
+    fn recv_within_bound(mut sockets: NaslSockets, fd: usize) -> Vec<u8> {
+        let (sender, receiver) = mpsc::channel();
+        thread::spawn(move || {
+            let _ = sender.send(recv_shared(&mut sockets, fd, 1024, None, Some(Seconds(5))));
+        });
+        receiver
+            .recv_timeout(Duration::from_secs(15))
+            .expect("recv did not return")
+            .unwrap()
+    }
+
+    #[test]
+    fn recv_returns_received_data_when_the_peer_closes() {
+        let listener = TcpListener::bind((Ipv4Addr::LOCALHOST, 0)).unwrap();
+        let (sockets, fd) = connected_socket(&listener);
+        let (mut peer, _) = listener.accept().unwrap();
+        peer.write_all(b"HTTP/1.0 400 Bad Request\r\n\r\n").unwrap();
+        drop(peer);
+
+        assert_eq!(
+            recv_within_bound(sockets, fd),
+            b"HTTP/1.0 400 Bad Request\r\n\r\n"
+        );
+    }
+
+    #[test]
+    fn recv_returns_received_data_when_the_peer_goes_quiet() {
+        let listener = TcpListener::bind((Ipv4Addr::LOCALHOST, 0)).unwrap();
+        let (sockets, fd) = connected_socket(&listener);
+        let (mut peer, _) = listener.accept().unwrap();
+        peer.write_all(b"220 ready\r\n").unwrap();
+
+        assert_eq!(recv_within_bound(sockets, fd), b"220 ready\r\n");
+        drop(peer);
+    }
+
+    #[test]
+    fn ftp_reply_cut_short_by_the_server_is_an_error() {
+        let reply = Cursor::new(b"220-Welcome\r\n".to_vec());
+
+        assert!(matches!(
+            check_ftp_response(reply, &[220]),
+            Err(SocketError::FailedToReadResponseCode)
+        ));
+    }
+}
