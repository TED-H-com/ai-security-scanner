+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn byte_slice_accepts_data_and_string_values() {
+        let data = NaslValue::Data(vec![0, 1, 2]);
+        assert_eq!(
+            <&[u8] as FromNaslValue>::from_nasl_value(&data).unwrap(),
+            &[0, 1, 2]
+        );
+
+        let string = NaslValue::String("GET / HTTP/1.0\\r\\n\\r\\n".to_string());
+        assert_eq!(
+            <&[u8] as FromNaslValue>::from_nasl_value(&string).unwrap(),
+            b"GET / HTTP/1.0\\r\\n\\r\\n"
+        );
+
+        let number = NaslValue::String("10".to_string());
+        assert_eq!(
+            <i32 as FromNaslValue>::from_nasl_value(&number).unwrap(),
+            10
+        );
+    }
+}
