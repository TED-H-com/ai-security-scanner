{
  "name": "ai-security-scanner",
  "private": true,
  "version": "0.5.3",
  "release": {
    "channel": "stable",
    "target": "0.5.3"
  },
  "description": "One guided desktop app for security checks across websites, networks, code, IaC, cloud, containers, and Kubernetes.",
  "license": "Apache-2.0",
  "author": "Ted Huang and ai-security-scanner contributors",
  "homepage": "https://ted-h-com.github.io/ai-security-scanner/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TED-H-com/ai-security-scanner.git"
  },
  "bugs": {
    "url": "https://github.com/TED-H-com/ai-security-scanner/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tauri": "tauri",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test:frontend": "node --experimental-strip-types --test tests/frontend/*.test.ts",
    "test:component": "vitest run --config vitest.config.ts",
    "upstream:refresh": "node scripts/upstream-refresh.mjs",
    "upstream:propose": "node scripts/upstream-propose.mjs",
    "test:release-evidence": "node --test tests/release/*.test.mjs",
    "test:usability-evidence": "node --test tests/usability/*.test.mjs",
    "validate:aidefend": "node scripts/validate-aidefend-snapshot.mjs",
    "validate:engine-line-endings": "node scripts/validate-engine-line-endings.mjs",
    "validate:engine-input-hashes": "git ls-files -z -- engines/images | node scripts/validate-engine-input-hashes.mjs",
    "validate:engines": "node scripts/validate-engine-line-endings.mjs && node scripts/validate-engine-catalog.mjs && node --test tests/engines/prowlerCatalogContract.test.mjs && npm run validate:engine-input-hashes",
    "validate:usability-evidence": "node scripts/validate-usability-evidence.mjs",
    "verify:vendored-glib": "bash scripts/verify-vendored-glib.sh",
    "desktop:prepare-sidecar": "node scripts/release/build-sidecar.mjs",
    "desktop:check": "node scripts/release/check-desktop.mjs",
    "release:validate": "node scripts/release/validate-release.mjs",
    "release:notices": "node scripts/release/generate-notices.mjs",
    "release:self-test": "node scripts/release/self-test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.1",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.1",
    "yaml": "2.9.1"
  }
}
