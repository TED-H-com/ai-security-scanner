{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TED-H-com/ai-security-scanner/schemas/master-framework-report.schema.json",
  "title": "ai-security-scanner optional Advanced framework-relationship export",
  "$comment": "This specialist export is not the beginner master report. The historical export_kind value is retained for wire compatibility only. Missing framework relationships cannot block scanning, findings, the beginner report, or a readable unsigned export.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_name",
    "product_version",
    "export_kind",
    "case_id",
    "selected_run_id",
    "selected_run_sequence",
    "selected_run_recorded_at",
    "notice",
    "coverage",
    "declared_ai_context",
    "observation_provenance",
    "frameworks",
    "unrecognized_relationships"
  ],
  "properties": {
    "schema_version": { "const": "1.4.0" },
    "product_name": { "const": "ai-security-scanner" },
    "product_version": { "type": "string", "minLength": 1 },
    "export_kind": {
      "const": "master_framework_relationship_report",
      "$comment": "Legacy wire identifier; product copy and new contracts call this the optional Advanced framework-relationship export."
    },
    "case_id": { "type": "string", "minLength": 1 },
    "selected_run_id": { "type": "string", "minLength": 1 },
    "selected_run_sequence": { "type": "integer", "minimum": 1 },
    "selected_run_recorded_at": { "type": "string", "format": "date-time" },
    "knowledge_date": {
      "type": "string",
      "format": "date-time",
      "deprecated": true,
      "$comment": "Optional legacy run-level timestamp retained for compatibility with v1.2 documents. It MUST NOT be interpreted as engine, rule, feed, database, or mapping freshness and MUST NOT establish scan coverage. Current technical records use per-engine knowledge inputs."
    },
    "notice": { "type": "string", "minLength": 1 },
    "coverage": { "$ref": "#/$defs/coverage" },
    "declared_ai_context": { "$ref": "#/$defs/declaredAiContext" },
    "observation_provenance": {
      "type": "array",
      "items": { "$ref": "#/$defs/observationProvenance" }
    },
    "frameworks": {
      "$comment": "The seven reference blocks are the shape of this optional export, not prerequisites for a scan or beginner report. A block can carry zero relationships or an unknown state.",
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/framework" },
            {
              "type": "object",
              "properties": {
                "framework": { "const": "NIST CSF" },
                "expected_version": { "const": "2.0" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/framework" },
            {
              "type": "object",
              "properties": {
                "framework": { "const": "ISO/IEC 27001" },
                "expected_version": { "const": "2022" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/framework" },
            {
              "type": "object",
              "properties": {
                "framework": { "const": "AIDEFEND" },
                "expected_version": { "const": "1.20260805" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/framework" },
            {
              "type": "object",
              "properties": {
                "framework": { "const": "OWASP Top 10" },
                "expected_version": { "const": "2021" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/framework" },
            {
              "type": "object",
              "properties": {
                "framework": { "const": "OWASP Top 10 for LLM Applications" },
                "expected_version": { "const": "2025" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/framework" },
            {
              "type": "object",
              "properties": {
                "framework": { "const": "CIS Kubernetes Benchmark" },
                "expected_version": { "const": "1.11" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/framework" },
            {
              "type": "object",
              "properties": {
                "framework": { "const": "CIS Amazon Web Services Foundations Benchmark" },
                "expected_version": { "const": "3.0.0" }
              }
            }
          ]
        }
      ],
      "items": false
    },
    "source_audits": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceAudit" } },
    "unrecognized_relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/unrecognizedRelationship" }
    }
  },
  "$defs": {
    "sourceAudit": {
      "type": "object", "additionalProperties": false,
      "description": "Profile-redacted shared source audit projection. Provider verdicts are not human triage or control conclusions. Source audit findings are intentionally not mapped to framework controls.",
      "required": ["task_id", "asset_ids", "admission_id", "method", "outcome", "counts", "coverage_by_status", "to_validate", "coverage_gaps", "unresolved_candidates", "technical_detail"],
      "properties": {
        "task_id": { "type": "string" },
        "asset_ids": { "$ref": "#/$defs/auditStrings" },
        "admission_id": { "type": "string" },
        "method": { "$ref": "#/$defs/sourceAuditMethod" },
        "outcome": { "$ref": "#/$defs/sourceAuditOutcome" },
        "counts": { "$ref": "#/$defs/countMap" },
        "coverage_by_status": { "$ref": "#/$defs/countMap" },
        "to_validate": { "type": "array", "items": { "$ref": "#/$defs/sourceAuditValidation" } },
        "coverage_gaps": { "type": "array", "items": { "$ref": "#/$defs/sourceAuditGap" } },
        "unresolved_candidates": { "$ref": "#/$defs/auditStrings" },
        "technical_detail": { "$ref": "#/$defs/sourceAuditTechnical" },
        "withheld_text_fields": { "$ref": "#/$defs/nonNegativeInteger" },
        "withheld_code_fields": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "auditStrings": { "type": "array", "items": { "type": "string" } },
    "sourceAuditMethod": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "upstream_commit", "validator_resources_sha256", "profile", "declared_invocation_limit", "issued_invocations", "remaining_invocations", "counts_by_role", "counts_by_state", "provenance", "verification_scope", "validators_reexecuted"],
      "properties": {
        "provider": { "type": "string" },
        "upstream_commit": { "type": "string" },
        "validator_resources_sha256": { "type": "string" },
        "profile": { "enum": ["quick", "standard", "deep"] },
        "declared_invocation_limit": { "type": ["integer", "null"], "minimum": 0 },
        "issued_invocations": { "$ref": "#/$defs/nonNegativeInteger" },
        "remaining_invocations": { "type": ["integer", "null"], "minimum": 0 },
        "counts_by_role": { "$ref": "#/$defs/countMap" },
        "counts_by_state": { "$ref": "#/$defs/countMap" },
        "provenance": { "enum": ["reported_only", "workflow_recorded"] },
        "verification_scope": { "type": "string" },
        "validators_reexecuted": { "type": "boolean" }
      }
    },
    "sourceAuditOutcome": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "incomplete_reason", "audit_performed"],
      "properties": {
        "state": { "enum": ["complete", "incomplete"] },
        "incomplete_reason": { "type": ["string", "null"] },
        "audit_performed": { "type": "boolean" }
      }
    },
    "sourceAuditGap": {
      "type": "object", "additionalProperties": false,
      "required": ["coverage_id", "status", "label", "continuation_paths", "unresolved"],
      "properties": {
        "coverage_id": { "type": "string" },
        "status": { "type": "string" },
        "label": { "type": "string" },
        "continuation_paths": { "$ref": "#/$defs/auditStrings" },
        "unresolved": { "$ref": "#/$defs/auditStrings" }
      }
    },
    "sourceAuditLocation": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "line", "view_file_sha256"],
      "properties": {
        "path": { "type": "string" },
        "line": { "$ref": "#/$defs/nonNegativeInteger" },
        "view_file_sha256": { "type": "string" }
      }
    },
    "sourceAuditValidation": {
      "type": "object", "additionalProperties": false,
      "required": ["native_record", "native_record_index", "native_record_sha256", "source_locations", "coverage_ids", "reported_verifier_assignments"],
      "properties": {
        "native_record": { "type": "object", "$comment": "Retained upstream record; native fields remain provider-owned and profile-redacted." },
        "native_record_index": { "$ref": "#/$defs/nonNegativeInteger" },
        "native_record_sha256": { "type": "string" },
        "source_locations": { "type": "array", "items": { "$ref": "#/$defs/sourceAuditLocation" } },
        "coverage_ids": { "$ref": "#/$defs/auditStrings" },
        "reported_verifier_assignments": { "$ref": "#/$defs/auditStrings" }
      }
    },
    "sourceAuditRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["fingerprint", "verdict", "severity", "native_record", "native_record_index", "native_record_sha256", "source_locations", "coverage_ids", "reported_verifier_assignments"],
      "properties": {
        "fingerprint": { "type": "string" },
        "verdict": { "enum": ["confirmed", "needs_validation", "rejected"] },
        "severity": { "enum": [null, "unknown", "informational", "low", "medium", "high", "critical"] },
        "native_record": { "type": "object" },
        "native_record_index": { "$ref": "#/$defs/nonNegativeInteger" },
        "native_record_sha256": { "type": "string" },
        "source_locations": { "type": "array", "items": { "$ref": "#/$defs/sourceAuditLocation" } },
        "coverage_ids": { "$ref": "#/$defs/auditStrings" },
        "reported_verifier_assignments": { "$ref": "#/$defs/auditStrings" }
      }
    },
    "sourceAuditArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["member_path", "artifact_id", "sha256", "byte_length"],
      "properties": {
        "member_path": { "type": "string" }, "artifact_id": { "type": "string" },
        "sha256": { "type": "string" }, "byte_length": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "sourceAuditTechnical": {
      "type": "object", "additionalProperties": false,
      "required": ["confirmed", "rejected", "coverage_ledger", "lineage", "custody_digests", "admission_sha256", "originals"],
      "properties": {
        "confirmed": { "type": "array", "items": { "$ref": "#/$defs/sourceAuditRecord" } },
        "rejected": { "type": "array", "items": { "$ref": "#/$defs/sourceAuditRecord" } },
        "coverage_ledger": { "type": "array", "items": { "type": "object" }, "$comment": "Complete native units and attempt history, profile-redacted." },
        "lineage": {
          "type": "object", "additionalProperties": false,
          "required": ["source", "identities", "source_id", "source_view_request_id"],
          "properties": {
            "source": { "$ref": "#/$defs/sourceAuditSource" }, "identities": { "$ref": "#/$defs/sourceAuditIdentity" },
            "source_id": { "type": "string" }, "source_view_request_id": { "type": "string" }
          }
        },
        "custody_digests": { "$ref": "#/$defs/sourceAuditDigests" },
        "admission_sha256": { "type": "string" },
        "originals": { "type": "array", "items": { "$ref": "#/$defs/sourceAuditArtifact" } }
      }
    },
    "sourceAuditSource": {
      "type": "object", "additionalProperties": false,
      "required": ["source_view_request_id", "source_view_receipt_sha256", "view_id", "view_sha256", "canonical_snapshot_id", "canonical_snapshot_sha256", "policy_id", "scope", "source_ref", "grant_sha256", "acknowledgement_sha256"],
      "properties": {
        "source_view_request_id": { "type": "string" },
        "source_view_receipt_sha256": { "type": "string" },
        "view_id": { "type": "string" },
        "view_sha256": { "type": "string" },
        "canonical_snapshot_id": { "type": "string" },
        "canonical_snapshot_sha256": { "type": "string" },
        "policy_id": { "type": "string" },
        "scope": { "$ref": "#/$defs/auditStrings" },
        "source_ref": { "type": "string" },
        "grant_sha256": { "type": "string" },
        "acknowledgement_sha256": { "type": "string" }
      }
    },
    "sourceAuditIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "asset_id", "run_id", "task_id", "session_id", "attempt_id"],
      "properties": {
        "case_id": { "type": "string" },
        "asset_id": { "type": "string" },
        "run_id": { "type": "string" },
        "task_id": { "type": "string" },
        "session_id": { "type": "string" },
        "attempt_id": { "type": "string" }
      }
    },
    "sourceAuditDigests": {
      "type": "object", "additionalProperties": false,
      "required": ["preparation_receipt_sha256", "source_view_receipt_sha256", "view_manifest_sha256", "view_sha256", "canonical_manifest_sha256", "sealed_entry_sha256", "bundle_sha256", "manifest_sha256", "retention_sha256", "workflow_sha256", "projection_sha256", "retained_projection_sha256"],
      "properties": {
        "preparation_receipt_sha256": { "type": "string" },
        "source_view_receipt_sha256": { "type": "string" },
        "view_manifest_sha256": { "type": "string" },
        "view_sha256": { "type": "string" },
        "canonical_manifest_sha256": { "type": "string" },
        "sealed_entry_sha256": { "type": "string" },
        "bundle_sha256": { "type": "string" },
        "manifest_sha256": { "type": "string" },
        "retention_sha256": { "type": "string" },
        "workflow_sha256": { "type": "string" },
        "projection_sha256": { "type": "string" },
        "retained_projection_sha256": { "type": "string" }
      }
    },
    "nonNegativeInteger": { "type": "integer", "minimum": 0 },
    "countMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/nonNegativeInteger" }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "selected_run_coverage_ledger_basis",
        "selected_run_checks_complete",
        "selected_run_coverage_ledger_available",
        "selected_run_coverage_has_unknown_or_incomplete_entries",
        "excluded_other_run_coverage_entry_count",
        "excluded_unbound_coverage_entry_count",
        "planned_engine_count",
        "completed_engine_count",
        "unfinished_engine_count",
        "not_executed_engine_count",
        "selected_run_planned_asset_count",
        "selected_run_matched_coverage_entry_count",
        "selected_run_missing_planned_asset_coverage_count",
        "selected_run_unmatched_coverage_entry_count",
        "unknown_source_count",
        "connected_no_asset_count",
        "authorized_incomplete_count",
        "discovered_not_authorized_count",
        "selected_run_finding_count",
        "selected_run_snapshot_count",
        "selected_run_missing_snapshot_count",
        "selected_run_observations_without_evidence_count",
        "selected_run_findings_with_framework_relationship",
        "selected_run_findings_without_framework_relationship",
        "engine_states",
        "selected_run_coverage_states",
        "limitations"
      ],
      "properties": {
        "state": {
          "const": "incomplete_or_unknown",
          "$comment": "Version 1.3 and later cannot establish exact requested-versus-executed host, address, port, protocol, path, stage, and task coverage from this engine/asset ledger. Historical v1.2 documents retain their own schema; current producers and documents MUST NOT claim the retired no-known-gap state."
        },
        "selected_run_coverage_ledger_basis": { "const": "selected_run_entries_matching_frozen_planned_assets" },
        "selected_run_checks_complete": { "type": "boolean" },
        "selected_run_coverage_ledger_available": { "type": "boolean" },
        "selected_run_coverage_has_unknown_or_incomplete_entries": { "type": "boolean" },
        "excluded_other_run_coverage_entry_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "excluded_unbound_coverage_entry_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "planned_engine_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "completed_engine_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "unfinished_engine_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "not_executed_engine_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "selected_run_planned_asset_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "selected_run_matched_coverage_entry_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "selected_run_missing_planned_asset_coverage_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "selected_run_unmatched_coverage_entry_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "unknown_source_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "connected_no_asset_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "authorized_incomplete_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "discovered_not_authorized_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "selected_run_finding_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "selected_run_snapshot_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "selected_run_missing_snapshot_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "selected_run_observations_without_evidence_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "selected_run_findings_with_framework_relationship": {
          "$ref": "#/$defs/nonNegativeInteger",
          "$comment": "How many selected-run findings the packaged mapping catalog could place."
        },
        "selected_run_findings_without_framework_relationship": {
          "$ref": "#/$defs/nonNegativeInteger",
          "$comment": "How many it could not. A finding counted here has no coordinate in any family; its framework position is unknown, not absent. Consumers MUST NOT read an absent coordinate as an assertion that no control relates."
        },
        "engine_states": { "$ref": "#/$defs/countMap" },
        "selected_run_coverage_states": { "$ref": "#/$defs/countMap" },
        "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "declaredAiContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ai_system_applicability", "ai_generated_artifact", "aidefend_applicability", "explanation"],
      "properties": {
        "ai_system_applicability": { "enum": ["applicable", "not_applicable", "unknown"] },
        "ai_generated_artifact": { "enum": ["yes", "no", "unknown"] },
        "aidefend_applicability": { "enum": ["applicable", "not_applicable", "unknown"] },
        "explanation": { "type": "string", "minLength": 1 }
      }
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework", "expected_version", "source", "observed_versions", "version_state", "observed_mapping_versions", "evidence_engine_mapping_versions", "mapping_version_state", "exact_match_relationship_count", "mismatch_relationship_count", "unavailable_relationship_count", "state", "relationship_count", "control_count", "finding_count", "explanation", "controls"],
      "properties": {
        "framework": {
          "enum": [
            "NIST CSF",
            "ISO/IEC 27001",
            "AIDEFEND",
            "OWASP Top 10",
            "OWASP Top 10 for LLM Applications",
            "CIS Kubernetes Benchmark",
            "CIS Amazon Web Services Foundations Benchmark"
          ]
        },
        "expected_version": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/frameworkSource" },
        "observed_versions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "version_state": { "enum": ["no_relationship_observed", "expected_version_only", "unexpected_version_observed"] },
        "observed_mapping_versions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "evidence_engine_mapping_versions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "mapping_version_state": { "enum": ["no_relationship_observed", "all_relationships_exact_match", "relationship_mismatch_observed", "relationship_provenance_unavailable"] },
        "exact_match_relationship_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "mismatch_relationship_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "unavailable_relationship_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "state": { "enum": ["related_coordinates_observed", "not_applicable_to_declared_context", "unknown_due_to_unanswered_context", "unknown_due_to_incomplete_coverage", "no_related_coordinate_observed"] },
        "relationship_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "control_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "finding_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "explanation": { "type": "string", "minLength": 1 },
        "controls": { "type": "array", "items": { "$ref": "#/$defs/control" } }
      }
    },
    "frameworkSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_url", "attribution_notice", "license_notice", "modifications_notice", "non_endorsement_notice"],
      "properties": {
        "source_url": { "type": "string", "minLength": 1 },
        "attribution_notice": { "type": "string", "minLength": 1 },
        "license_notice": { "type": "string", "minLength": 1 },
        "modifications_notice": { "type": "string", "minLength": 1 },
        "non_endorsement_notice": { "type": "string", "minLength": 1 }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_id", "title", "framework_version", "relationships"],
      "properties": {
        "control_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "framework_version": { "type": "string", "minLength": 1 },
        "relationships": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/relationship" } }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mapping_version_state": { "const": "exact_match" },
            "mapping_provenance_state": { "const": "verified_current_catalog" },
            "mapping_provenance": { "$ref": "#/$defs/mappingProvenance" }
          }
        },
        {
          "type": "object",
          "properties": {
            "mapping_version_state": { "enum": ["mismatch", "unavailable"] }
          }
        }
      ],
      "required": ["relationship", "rationale", "mapping_version", "mapping_provenance_state", "mapping_provenance", "mapping_version_state", "finding", "evidence_bindings"],
      "properties": {
        "relationship": { "const": "related" },
        "rationale": { "type": "string", "minLength": 1 },
        "mapping_version": { "type": "string", "minLength": 1 },
        "mapping_provenance_state": { "enum": ["verified_current_catalog", "unverified_historical_catalog", "unavailable_legacy"] },
        "mapping_provenance": {
          "oneOf": [
            { "$ref": "#/$defs/mappingProvenance" },
            { "type": "null" }
          ]
        },
        "mapping_version_state": { "enum": ["exact_match", "mismatch", "unavailable"] },
        "finding": { "$ref": "#/$defs/finding" },
        "evidence_bindings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceBinding" } }
      }
    },
    "mappingProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapping_version", "reviewed_at", "review_process", "catalog_sha256"],
      "properties": {
        "mapping_version": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$" },
        "reviewed_at": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "review_process": { "type": "string", "minLength": 1, "maxLength": 128 },
        "catalog_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "evidenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "source_rule": { "type": "string", "minLength": 1, "maxLength": 512 },
            "engine_mapping_version": { "type": "string", "minLength": 1 },
            "engine_mapping_provenance_state": { "const": "verified_current_catalog" },
            "engine_mapping_provenance": { "$ref": "#/$defs/mappingProvenance" },
            "mapping_version_state": { "const": "exact_match" }
          }
        },
        {
          "type": "object",
          "properties": {
            "mapping_version_state": { "enum": ["mismatch", "unavailable"] }
          }
        }
      ],
      "required": ["evidence_id", "artifact_id", "artifact_sha256", "engine_run_id", "engine_id", "source_rule", "engine_mapping_version", "engine_mapping_provenance_state", "engine_mapping_provenance", "mapping_version_state"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "artifact_id": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "engine_run_id": { "type": "string", "minLength": 1 },
        "engine_id": { "type": "string", "minLength": 1 },
        "source_rule": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 512 },
            { "type": "null" }
          ]
        },
        "engine_mapping_version": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "engine_mapping_provenance_state": { "enum": ["verified_current_catalog", "unverified_historical_catalog", "unavailable_legacy", "source_audit_not_mapped"] },
        "engine_mapping_provenance": {
          "oneOf": [
            { "$ref": "#/$defs/mappingProvenance" },
            { "type": "null" }
          ]
        },
        "mapping_version_state": { "enum": ["exact_match", "mismatch", "unavailable"] }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "finding_id", "fingerprint", "title", "severity", "confidence", "observed_at", "snapshot_source", "evidence_hashes", "asset_ids", "engine_ids"],
      "properties": {
        "observation_id": { "type": "string", "minLength": 1 },
        "finding_id": { "type": "string", "minLength": 1 },
        "fingerprint": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["unknown", "informational", "low", "medium", "high", "critical"] },
        "confidence": { "enum": ["unknown", "low", "medium", "high", "confirmed"] },
        "observed_at": { "type": "string", "format": "date-time" },
        "snapshot_source": { "const": "run_snapshot" },
        "evidence_hashes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$" } },
        "asset_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "engine_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "observationProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "finding_id", "fingerprint", "snapshot_state", "evidence_reference_state", "framework_mapping_state"],
      "properties": {
        "observation_id": { "type": "string", "minLength": 1 },
        "finding_id": { "type": "string", "minLength": 1 },
        "fingerprint": { "type": "string", "minLength": 1 },
        "snapshot_state": { "enum": ["run_snapshot", "legacy_run_snapshot_missing"] },
        "evidence_reference_state": { "enum": ["missing", "validated_from_observation_only", "validated_from_run_snapshot"] },
        "framework_mapping_state": {
          "enum": ["run_snapshot_relationships_used", "no_packaged_catalog_relationship", "not_exported_without_exact_evidence", "not_exported_without_run_snapshot", "source_audit_not_mapped"],
          "$comment": "Version 1.4 separates no_packaged_catalog_relationship -- a complete, exactly evidenced snapshot the catalog carries no entry for -- from run_snapshot_relationships_used. Version 1.3 documents reported both as the latter. source_audit_not_mapped means admitted source audit findings are intentionally not mapped to framework controls; it is not missing legacy provenance."
        }
      }
    },
    "unrecognizedRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "framework", "framework_version", "control_id"],
      "properties": {
        "finding_id": { "type": "string", "minLength": 1 },
        "framework": { "type": "string", "minLength": 1 },
        "framework_version": { "type": "string", "minLength": 1 },
        "control_id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
