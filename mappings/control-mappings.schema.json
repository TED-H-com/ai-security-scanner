{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TED-H-com/ai-security-scanner/blob/main/mappings/control-mappings.schema.json",
  "title": "ai-security-scanner evidence-to-control mapping catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mapping_version",
    "provenance",
    "relationship",
    "disclaimer",
    "sources",
    "controls",
    "entries"
  ],
  "properties": {
    "schema_version": { "const": "1.1" },
    "mapping_version": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewed_at", "review_process", "canonical_sha256"],
      "properties": {
        "reviewed_at": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "review_process": { "const": "source_coordinate_and_rationale_review_v1" },
        "canonical_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "relationship": { "const": "related" },
    "disclaimer": { "type": "string", "minLength": 40, "maxLength": 512 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["framework", "framework_version", "url"],
        "properties": {
          "framework": { "type": "string", "minLength": 1, "maxLength": 80 },
          "framework_version": { "type": "string", "minLength": 1, "maxLength": 40 },
          "url": {
            "type": "string",
            "format": "uri",
            "minLength": 9,
            "maxLength": 2048,
            "pattern": "^https://[^@]+$"
          }
        }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "framework", "framework_version", "control_id", "title"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,79}$" },
          "framework": { "type": "string", "minLength": 1, "maxLength": 80 },
          "framework_version": { "type": "string", "minLength": 1, "maxLength": 40 },
          "control_id": { "type": "string", "minLength": 1, "maxLength": 80 },
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "applicability": {
            "enum": ["ai_system", "ai_generated_artifact"]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "framework": {
                  "enum": ["AIDEFEND", "OWASP Top 10 for LLM Applications"]
                }
              },
              "required": ["framework"]
            },
            "then": { "required": ["applicability"] },
            "else": { "not": { "required": ["applicability"] } }
          }
        ]
      }
    },
    "entries": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["engine_id", "match_kind", "source_rule", "controls", "rationale"],
        "properties": {
          "engine_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "match_kind": { "enum": ["exact", "prefix"] },
          "source_rule": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "allOf": [
              { "pattern": "^[^*?\\[\\]]+$" },
              { "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
              { "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$" }
            ]
          },
          "controls": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "rationale": {
            "type": "string",
            "minLength": 20,
            "maxLength": 512,
            "allOf": [
              { "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
              { "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$" }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "match_kind": { "const": "prefix" } },
              "required": ["match_kind"]
            },
            "then": {
              "properties": { "source_rule": { "minLength": 4 } }
            }
          }
        ]
      }
    },
    "cwe_derived_controls": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["control", "cwe_ids", "rationale"],
        "properties": {
          "control": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,79}$" },
          "cwe_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^CWE-[0-9]+$" }
          },
          "rationale": {
            "type": "string",
            "minLength": 20,
            "maxLength": 512,
            "allOf": [
              { "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
              { "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$" }
            ]
          }
        }
      }
    }
  }
}
